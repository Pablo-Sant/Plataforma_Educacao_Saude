from pydantic import BaseModel, field_validator
from typing import Optional
from enum import Enum


class ClassificacaoUrgencia(str, Enum):
    BAIXA = "baixa"
    MEDIA = "media"
    ALTA = "alta"


class TriagemResultado(BaseModel):
    classificacao: ClassificacaoUrgencia
    pontuacao_total: int


class PerguntaFluxoOut(BaseModel):
    id: int
    texto: str
    tipo: Optional[str] = None

    model_config = {
        "from_attributes": True
    }


class FluxoRespostaInput(BaseModel):
    pergunta_id: int
    opcao_resposta_id: int
    resposta: str

    @field_validator("resposta")
    @classmethod
    def validar_resposta(cls, value: str):
        value = value.lower().strip()

        if value not in ["sim", "nao"]:
            raise ValueError(
                "a resposta deve ser 'sim' ou 'nao'"
            )

        return value


class FluxoRespostaOut(BaseModel):
    concluido: bool = False
    proxima_pergunta: Optional[PerguntaFluxoOut] = None
    resultado: Optional[TriagemResultado] = None