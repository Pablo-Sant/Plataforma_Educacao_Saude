from dataclasses import dataclass

from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select

from backend.models.pergunta_model import PerguntaModel
from backend.models.opcao_resposta_model import OpcaoRespostaModel

from backend.schemas.fluxo_schema import (
    ClassificacaoUrgencia,
    TriagemResultado
)



# FILA DE TRIAGEM 


@dataclass
class PacienteFila:
    codigo: str
    pontuacao: int = 0


fila_triagem: list[PacienteFila] = []



# BUSCAR PERGUNTA


async def buscar_pergunta(
    db: AsyncSession,
    pergunta_id: int
):
    return await db.get(
        PerguntaModel,
        pergunta_id
    )



# BUSCAR OPÇÕES DA PERGUNTA


async def buscar_opcoes(
    db: AsyncSession,
    pergunta_id: int
):
    result = await db.execute(
        select(OpcaoRespostaModel).where(
            OpcaoRespostaModel.pergunta_id == pergunta_id
        )
    )

    return result.scalars().all()



# BUSCAR UMA OPÇÃO


async def buscar_opcao(
    db: AsyncSession,
    opcao_id: int
):
    return await db.get(
        OpcaoRespostaModel,
        opcao_id
    )



# ADICIONA OU ATUALIZA PACIENTE NA FILA


async def atualizar_fila(
    codigo: str,
    pontos: int
):

    paciente = next(
        (
            p
            for p in fila_triagem
            if p.codigo == codigo
        ),
        None
    )

    if paciente is None:

        paciente = PacienteFila(
            codigo=codigo,
            pontuacao=0
        )

        fila_triagem.append(paciente)

    paciente.pontuacao += pontos

    fila_triagem.sort(
        key=lambda p: p.pontuacao,
        reverse=True
    )

    return paciente



# PROCESSAR RESPOSTA DA TRIAGEM


async def processar_resposta(
    db: AsyncSession,
    codigo: str,
    pergunta_id: int,
    opcao_id: int
):
    # Busca a pergunta pelo ID
    pergunta = await buscar_pergunta(
        db,
        pergunta_id
    )

    if pergunta is None:
        raise Exception("Pergunta não encontrada.")

    # Busca a opção escolhida
    opcao = await buscar_opcao(
        db,
        opcao_id
    )

    if opcao is None:
        raise Exception("Opção não encontrada.")

    pontos = 0

    
    if opcao.descricao.strip().lower() == "sim":
        pontos = pergunta.peso

    paciente = await atualizar_fila(
        codigo,
        pontos
    )

    if paciente.pontuacao >= 10:
        classificacao = ClassificacaoUrgencia.ALTA

    elif paciente.pontuacao >= 5:
        classificacao = ClassificacaoUrgencia.MEDIA

    else:
        classificacao = ClassificacaoUrgencia.BAIXA

    return TriagemResultado(
        classificacao=classificacao,
        pontuacao_total=paciente.pontuacao
    )



# LISTAR FILA


async def listar_fila():

    fila_triagem.sort(
        key=lambda p: p.pontuacao,
        reverse=True
    )

    return [
        {
            "codigo": paciente.codigo,
            "pontuacao": paciente.pontuacao
        }
        for paciente in fila_triagem
    ]



# REMOVER PACIENTE DA FILA


async def remover_paciente(
    codigo: str
):

    paciente = next(
        (
            p
            for p in fila_triagem
            if p.codigo == codigo
        ),
        None
    )

    if paciente is None:
        return False

    fila_triagem.remove(paciente)

    return True



# BUSCAR PACIENTE NA FILA


async def buscar_paciente(
    codigo: str
):

    paciente = next(
        (
            p
            for p in fila_triagem
            if p.codigo == codigo
        ),
        None
    )

    return paciente



# CALCULAR CLASSIFICAÇÃO ATUAL


async def calcular_triagem(
    codigo: str
):

    paciente = await buscar_paciente(
        codigo
    )

    if paciente is None:
        raise Exception("Paciente não encontrado na fila.")

    if paciente.pontuacao >= 10:
        classificacao = ClassificacaoUrgencia.ALTA

    elif paciente.pontuacao >= 5:
        classificacao = ClassificacaoUrgencia.MEDIA

    else:
        classificacao = ClassificacaoUrgencia.BAIXA

    return TriagemResultado(
        classificacao=classificacao,
        pontuacao_total=paciente.pontuacao
    )