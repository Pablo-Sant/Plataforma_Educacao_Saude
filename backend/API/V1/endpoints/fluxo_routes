from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.ext.asyncio import AsyncSession

from backend.core.database import get_db

from backend.models.atendimentos_model import AtendimentoModel

from backend.schemas.fluxo_schema import (
    FluxoRespostaInput,
    FluxoRespostaOut,
    PerguntaFluxoOut,
    TriagemResultado
)
#########################################################
#########ainda tentando arrumar o fluxo com proxima pergunta id
###################################################################


########testar conexao banco



from backend.services.fluxo_service import (
    buscar_pergunta,
    buscar_opcoes,
    salvar_resposta,
    calcular_triagem
)

router = APIRouter(
    prefix="/fluxo",
    tags=["Fluxo de Triagem"]
)


@router.get(
    "/{atendimento_id}/iniciar",
    response_model=FluxoRespostaOut
)
async def iniciar_fluxo(
    atendimento_id: int,
    db: AsyncSession = Depends(get_db)
):

    atendimento = await db.get(
        AtendimentoModel,
        atendimento_id
    )

    if not atendimento:
        raise HTTPException(
            status_code=404,
            detail="Atendimento não encontrado"
        )

    pergunta = await buscar_pergunta(
        db,
        1
    )

    if not pergunta:
        raise HTTPException(
            status_code=404,
            detail="Nenhuma pergunta cadastrada"
        )

    return FluxoRespostaOut(
        concluido=False,
        proxima_pergunta=PerguntaFluxoOut(
            id=pergunta.id,
            texto=pergunta.texto,
            tipo=pergunta.tipo
        )
    )


@router.post(
    "/{atendimento_id}/responder",
    response_model=FluxoRespostaOut
)
async def responder_pergunta(
    atendimento_id: int,
    body: FluxoRespostaInput,
    db: AsyncSession = Depends(get_db)
):

    atendimento = await db.get(
        AtendimentoModel,
        atendimento_id
    )

    if not atendimento:
        raise HTTPException(
            status_code=404,
            detail="Atendimento não encontrado"
        )

    pergunta = await buscar_pergunta(
        db,
        body.pergunta_id
    )

    if not pergunta:
        raise HTTPException(
            status_code=404,
            detail="Pergunta não encontrada"
        )

    opcao = await salvar_resposta(
        db,
        atendimento_id,
        body.pergunta_id,
        body.opcao_resposta_id,
        body.resposta
    )

    if not opcao.proxima_pergunta_id:

        resultado = await calcular_triagem(
            db,
            atendimento_id
        )

        return FluxoRespostaOut(
            concluido=True,
            resultado=resultado,
            proxima_pergunta=None
        )

    proxima_pergunta = await buscar_pergunta(
        db,
        opcao.proxima_pergunta_id
    )

    if not proxima_pergunta:

        resultado = await calcular_triagem(
            db,
            atendimento_id
        )

        return FluxoRespostaOut(
            concluido=True,
            resultado=resultado,
            proxima_pergunta=None
        )

    return FluxoRespostaOut(
        concluido=False,
        proxima_pergunta=PerguntaFluxoOut(
            id=proxima_pergunta.id,
            texto=proxima_pergunta.texto,
            tipo=proxima_pergunta.tipo
        )
    )